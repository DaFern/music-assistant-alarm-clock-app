diff --git a/app/skill/player_directory.py b/app/skill/player_directory.py
new file mode 100644
index 0000000..8ee450d
--- /dev/null
+++ b/app/skill/player_directory.py
@@ -0,0 +1,47 @@
+"""Read the authorized MA player directory without sending playback commands."""
+import asyncio
+
+import aiohttp
+from music_assistant_client import MusicAssistantClient
+from env_secrets import get_env_secret
+
+
+class PlayerDirectoryError(Exception):
+    """The authoritative player list could not be retrieved."""
+
+
+async def _fetch_players():
+    server = get_env_secret("MA_API_URL")
+    token = get_env_secret("MA_API_TOKEN")
+    if not server or not token:
+        raise PlayerDirectoryError("Music Assistant API settings are missing.")
+    async with aiohttp.ClientSession() as session:
+        async with MusicAssistantClient(server, session, token=token) as client:
+            values = await client.send_command("players/all")
+    if not isinstance(values, list):
+        raise PlayerDirectoryError("Music Assistant returned an invalid player list.")
+    players = {}
+    for value in values:
+        if not isinstance(value, dict):
+            continue
+        player_id = value.get("player_id")
+        if not isinstance(player_id, str) or not player_id:
+            continue
+        name = value.get("name")
+        players[player_id] = {
+            "player_id": player_id,
+            "name": name if isinstance(name, str) and name else player_id,
+            "available": value.get("available") is True,
+        }
+    return sorted(players.values(), key=lambda player: (player["name"].casefold(), player["player_id"]))
+
+
+def list_players():
+    """Return a fresh list visible to the configured token, bounded to five seconds."""
+    try:
+        return asyncio.run(asyncio.wait_for(_fetch_players(), timeout=5))
+    except PlayerDirectoryError:
+        raise
+    except Exception:
+        # Do not embed URLs, credentials or server exception text in the web response.
+        raise PlayerDirectoryError("Could not reach Music Assistant. Existing mappings are unchanged.") from None
diff --git a/tests/portable/test_pairing_directory.py b/tests/portable/test_pairing_directory.py
new file mode 100644
index 0000000..4caa26d
--- /dev/null
+++ b/tests/portable/test_pairing_directory.py
@@ -0,0 +1,119 @@
+"""Directory selection regressions. No credentials, playback or external I/O."""
+import asyncio
+import os
+from pathlib import Path
+import sys
+from types import SimpleNamespace as N
+import unittest
+from unittest.mock import AsyncMock, MagicMock, patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / 'app'))
+from flask import Flask
+from endpoints.devices import devices_bp
+from skill import player_directory as directory, music_search
+from music_assistant_models.errors import PlayerUnavailableError
+
+
+class DropdownTests(unittest.TestCase):
+    def setUp(self):
+        self.app = Flask(__name__)
+        self.app.register_blueprint(devices_bp)
+        self.mapping = patch('skill.device_mapping.load_mapping', return_value={'echo': "Kid's speaker"})
+        self.mapping.start()
+        self.addCleanup(self.mapping.stop)
+        self.players = [
+            {'player_id': "Kid's speaker", 'name': 'Bedroom', 'available': False},
+            {'player_id': 'Patio-ID', 'name': 'Garden', 'available': True},
+        ]
+
+    def test_dropdown_uses_exact_ids_and_shows_availability(self):
+        with self.app.test_client() as client, patch('endpoints.devices.list_players', return_value=self.players):
+            page = client.get('/devices').get_data(as_text=True)
+        self.assertIn('<select name="player_id"', page)
+        self.assertIn('value="Kid&#39;s speaker" selected', page)
+        self.assertIn('Bedroom — Unavailable', page)
+        self.assertIn('Garden — Available', page)
+        self.assertIn('value="Patio-ID"', page)
+        self.assertNotIn('type="text" name="player_id"', page)
+
+    def test_unknown_saved_mapping_remains_visible(self):
+        with self.app.test_client() as client, patch('endpoints.devices.list_players', return_value=[]):
+            page = client.get('/devices').get_data(as_text=True)
+        self.assertIn('Kid&#39;s speaker', page)
+        self.assertIn('Saved; not returned by Music Assistant', page)
+
+    def test_outage_does_not_offer_an_empty_replacement_or_save(self):
+        with self.app.test_client() as client, patch('endpoints.devices.list_players', side_effect=directory.PlayerDirectoryError('Connection failed')):
+            page = client.get('/devices').get_data(as_text=True)
+        self.assertIn('Connection failed', page)
+        self.assertIn('Kid&#39;s speaker', page)
+        self.assertIn('<button type="submit" disabled>', page)
+
+    def test_typed_nonexistent_id_is_rejected_without_write(self):
+        with self.app.test_client() as client, patch('endpoints.devices.list_players', return_value=self.players), patch('skill.device_mapping.set_player_for_device') as save:
+            response = client.post('/devices', data={'device_id': 'echo', 'player_id': 'Kids speaker'})
+        self.assertEqual(response.status_code, 400)
+        save.assert_not_called()
+
+    def test_server_outage_rejects_save_without_write(self):
+        with self.app.test_client() as client, patch('endpoints.devices.list_players', side_effect=directory.PlayerDirectoryError('Connection failed')), patch('skill.device_mapping.set_player_for_device') as save:
+            response = client.post('/devices', data={'device_id': 'echo', 'player_id': 'Patio-ID'})
+        self.assertEqual(response.status_code, 503)
+        save.assert_not_called()
+
+    def test_unavailable_but_real_player_can_be_paired(self):
+        with self.app.test_client() as client, patch('endpoints.devices.list_players', return_value=self.players) as fetch, patch('skill.device_mapping.set_player_for_device', return_value=True) as save:
+            response = client.post('/devices', data={'device_id': 'echo', 'player_id': "Kid's speaker"})
+        self.assertEqual(response.status_code, 302)
+        save.assert_called_once_with('echo', "Kid's speaker")
+        fetch.assert_called_once_with()
+
+    def test_explicit_unpair_does_not_require_server_connection(self):
+        with self.app.test_client() as client, patch('endpoints.devices.list_players') as fetch, patch('skill.device_mapping.set_player_for_device', return_value=True) as save:
+            response = client.post('/devices', data={'device_id': 'echo', 'player_id': ''})
+        self.assertEqual(response.status_code, 302)
+        fetch.assert_not_called()
+        save.assert_called_once_with('echo', None)
+
+    def test_names_and_ids_are_html_escaped(self):
+        players = [{'player_id': '"><script>bad</script>', 'name': '<img src=x>', 'available': True}]
+        with self.app.test_client() as client, patch('endpoints.devices.list_players', return_value=players):
+            page = client.get('/devices').get_data(as_text=True)
+        self.assertNotIn('<script>bad', page)
+        self.assertNotIn('<img src=x>', page)
+        self.assertIn('&lt;img', page)
+
+
+class DirectoryTests(unittest.IsolatedAsyncioTestCase):
+    async def test_directory_reads_only_players_command_and_normalizes_values(self):
+        client = MagicMock()
+        client.send_command = AsyncMock(return_value=[
+            {'player_id': 'id-2', 'name': 'Patio', 'available': True},
+            {'player_id': 'id-1', 'name': '', 'available': False},
+            {'player_id': 'id-2', 'name': 'Garden', 'available': True},
+            {'name': 'No id'}, None,
+        ])
+        manager = MagicMock()
+        manager.__aenter__ = AsyncMock(return_value=client)
+        manager.__aexit__ = AsyncMock(return_value=False)
+        with patch.object(directory, 'get_env_secret', return_value='configured'), patch.object(directory, 'MusicAssistantClient', return_value=manager):
+            players = await directory._fetch_players()
+        self.assertEqual([p['player_id'] for p in players], ['id-2', 'id-1'])
+        self.assertEqual(players[1]['name'], 'id-1')
+        client.send_command.assert_awaited_once_with('players/all')
+
+    async def test_missing_config_never_connects(self):
+        with patch.object(directory, 'get_env_secret', return_value=None), patch.object(directory, 'MusicAssistantClient') as connect:
+            with self.assertRaises(directory.PlayerDirectoryError):
+                await directory._fetch_players()
+        connect.assert_not_called()
+
+
+class FriendlyErrorTests(unittest.TestCase):
+    def test_unavailable_player_has_actionable_voice_response(self):
+        async def fail(*args):
+            raise PlayerUnavailableError('Unavailable')
+        with patch.object(music_search, '_search_and_play', side_effect=fail):
+            message = music_search.search_and_play('any-player', 'any artist')
+        self.assertIn('speaker is unavailable', message)
+        self.assertIn('devices page', message)
