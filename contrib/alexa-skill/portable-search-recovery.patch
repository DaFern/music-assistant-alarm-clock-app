+from collections.abc import MutableMapping
+from contextvars import ContextVar
+import shared_store
+
+_request_info = ContextVar("alexa_request_info", default=None)
+
+
+class RequestInfo(MutableMapping):
+    """Keep the existing metadata interface without sharing data between requests."""
+    def _value(self):
+        value = _request_info.get()
+        if value is None:
+            value = {}
+            _request_info.set(value)
+        return value
+
+    def __getitem__(self, key):
+        return self._value()[key]
+
+    def __setitem__(self, key, value):
+        self._value()[key] = value
+
+    def __delitem__(self, key):
+        del self._value()[key]
+
+    def __iter__(self):
+        return iter(self._value())
+
+    def __len__(self):
+        return len(self._value())
+
+
+info = RequestInfo()
+
+
+def begin_request(player_id):
+    # An unmapped Echo is explicitly blocked from using global transport state.
+    shared_store.request_player.set(player_id or "")
+    _request_info.set({})
+
 
