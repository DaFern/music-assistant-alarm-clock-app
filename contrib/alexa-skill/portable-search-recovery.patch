diff --git a/app/shared_store.py b/app/shared_store.py
index 58cd7a8..c5b9164 100644
--- a/app/shared_store.py
+++ b/app/shared_store.py
@@ -1,4 +1,44 @@
-"""Shared store for MA and Alexa routes."""
+"""Process-local stream publications, isolated by player for mapped Echos."""
+from contextvars import ContextVar
+from threading import RLock
+from urllib.parse import unquote, urlsplit
 
-_store = None
+_store = None  # Legacy unscoped status endpoints only; never a mapped Echo fallback.
 _version = 0
+_players = {}
+_lock = RLock()
+request_player = ContextVar("alexa_request_player", default=None)
+
+
+def player_from_url(url):
+    """Extract the player from MA's flow or announcement route, without decoding slashes."""
+    if not isinstance(url, str):
+        return None
+    parts = urlsplit(url).path.strip("/").split("/")
+    if len(parts) == 5 and parts[0] == "flow":
+        player = unquote(parts[2])
+        filename = unquote(parts[4]).rsplit(".", 1)[0]
+        return player if player and filename == player else None
+    if len(parts) == 2 and parts[0] == "announcement":
+        return unquote(parts[1]).rsplit(".", 1)[0] or None
+    return None
+
+
+def publish(payload):
+    """Atomically publish one stream; unidentifiable URLs stay unscoped."""
+    global _store, _version
+    with _lock:
+        _version += 1
+        value = dict(payload, version=_version)
+        _store = value
+        player = player_from_url(value.get("streamUrl"))
+        if player:
+            _players[player] = value
+        return dict(value)
+
+
+def latest(player_id=None):
+    """Read a copy; a scoped miss must never return another player's stream."""
+    with _lock:
+        value = _players.get(player_id) if player_id else _store
+        return dict(value) if value else None
