new file mode 100644
index 0000000..82c623d
--- /dev/null
+++ b/app/skill/music_search.py
@@ -0,0 +1,119 @@
+"""Search Music Assistant and play a matching item on the mapped Echo."""
+import asyncio
+import logging
+import re
+import unicodedata
+
+import aiohttp
+from music_assistant_client import MusicAssistantClient
+from music_assistant_models.enums import MediaType, QueueOption
+from env_secrets import get_env_secret
+
+logger = logging.getLogger(__name__)
+
+
+def normalize(value):
+    value = unicodedata.normalize("NFKC", value or "").casefold()
+    return " ".join(re.findall(r"\w+", value))
+
+
+def parse_query(query):
+    query = query.strip()
+    patterns = (
+        (r"^(?:songs|music|tracks) by (.+)$", MediaType.ARTIST),
+        (r"^(?:the )?artist (.+)$", MediaType.ARTIST),
+        (r"^(?:the )?album (.+)$", MediaType.ALBUM),
+        (r"^(?:the )?playlist (.+)$", MediaType.PLAYLIST),
+        (r"^(?:the )?(?:song|track) (.+)$", MediaType.TRACK),
+    )
+    for pattern, kind in patterns:
+        match = re.match(pattern, query, re.I)
+        if match:
+            return match.group(1).strip(), kind
+    return query, None
+
+
+async def _search_and_play(player_id, query):
+    server = get_env_secret("MA_API_URL")
+    token = get_env_secret("MA_API_TOKEN")
+    if not server or not token:
+        return "Music Assistant search is not configured."
+    if not player_id:
+        return "This Echo needs a Music Assistant player mapping first."
+    if not query or not query.strip():
+        return "Which artist, song, album or playlist would you like?"
+
+    title, kind = parse_query(query)
+    artist = None
+    if kind != MediaType.ARTIST:
+        parts = re.split(r"\s+by\s+", title, maxsplit=1, flags=re.I)
+        if len(parts) == 2:
+            title, artist = parts
+
+    search_text = f"{title} {artist}" if artist else title
+    kinds = [kind] if kind else [
+        MediaType.ARTIST, MediaType.TRACK,
+        MediaType.ALBUM, MediaType.PLAYLIST,
+    ]
+
+    async with aiohttp.ClientSession() as session:
+        async with MusicAssistantClient(server, session, token=token) as client:
+            results = await client.music.search(
+                search_text, media_types=kinds, limit=20
+            )
+            groups = {
+                MediaType.ARTIST: results.artists,
+                MediaType.TRACK: results.tracks,
+                MediaType.ALBUM: results.albums,
+                MediaType.PLAYLIST: results.playlists,
+            }
+            matches = []
+            for media_type in kinds:
+                for item in groups.get(media_type, []):
+                    if normalize(item.name) != normalize(title):
+                        continue
+                    if artist and not any(
+                        normalize(a.name) == normalize(artist)
+                        for a in getattr(item, "artists", [])
+                    ):
+                        continue
+                    matches.append(item)
+
+            # Collapse repeated URIs only; matching names do not establish identity.
+            unique = {}
+            for item in matches:
+                key = item.uri
+                unique.setdefault(key, item)
+            matches = list(unique.values())
+
+            # A bare artist name such as "Ghost" should select that artist.
+            if kind is None and not artist:
+                artists = [i for i in matches
+                           if i.media_type == MediaType.ARTIST]
+                if artists:
+                    matches = artists
+
+            if not matches:
+                return "I found no exact match. Please specify the artist, song, album or playlist."
+            if len(matches) > 1:
+                return "I found several matches. Please include the artist and say whether it is a song, album or playlist."
+
+            item = matches[0]
+            queue = await client.player_queues.get_active_queue(player_id)
+            queue_id = queue.queue_id if queue else player_id
+            await client.player_queues.play_media(
+                queue_id, item.uri, option=QueueOption.REPLACE
+            )
+            return f"Requested {item.name} on {player_id}."
+
+
+def search_and_play(player_id, query):
+    try:
+        return asyncio.run(asyncio.wait_for(
+            _search_and_play(player_id, query), timeout=6
+        ))
+    except asyncio.TimeoutError:
+        return "Music Assistant took too long. Please check playback before trying again."
+    except Exception:
+        logger.exception("Music search or playback request failed")
+        return "I could not complete the music request."
